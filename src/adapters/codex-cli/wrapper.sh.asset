#!/bin/sh
# ===== GPTW-CODEX-CLI =====
# Reversible GPTW wrapper around the npm-installed codex shim.
# Prints a one-line ad banner read from "__GPTW_AD_PATH__" then
# exec's the pristine shim at "__GPTW_BACKUP__".
# Restore: copy that backup back over this file (or run gptw restore).
AD_FILE="__GPTW_AD_PATH__"
AD_TEXT="Earning GPTW"
if [ -r "$AD_FILE" ]; then
  AD_TEXT=$(head -n 1 "$AD_FILE" 2>/dev/null || echo "Earning GPTW")
fi
printf '\n  [ad]  %s\n\n' "$AD_TEXT"
exec "__GPTW_BACKUP__" "$@"
