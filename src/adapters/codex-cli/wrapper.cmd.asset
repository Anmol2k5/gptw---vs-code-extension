@ECHO off
REM ===== GPTW-CODEX-CLI =====
REM Reversible GPTW wrapper around the npm-installed codex shim.
REM Prints a one-line ad banner read from "__GPTW_AD_PATH__" then
REM delegates to the pristine shim at "__GPTW_BACKUP__".
REM Restore: copy that backup back over this file (or run gptw restore).
setlocal enabledelayedexpansion
set "__GPTW_AD_FILE=__GPTW_AD_PATH__"
set "__GPTW_AD=Earning GPTW"
if exist "%__GPTW_AD_FILE%" (
  for /f "usebackq delims=" %%A in ("%__GPTW_AD_FILE%") do (
    set "__GPTW_AD=%%A"
    goto :__gptw_after
  )
)
:__gptw_after
echo.
echo   [ad]  !__GPTW_AD!
echo.
endlocal & call "__GPTW_BACKUP__" %*
