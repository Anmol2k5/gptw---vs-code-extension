{
  "name": "gptw",
  "displayName": "Get Paid to Wait - GPTW",
  "publisher": "gptw",
  "version": "0.3.174",
  "description": "Get paid while you code. Subtle, clickable ads in the Claude Code and Codex spinners.",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/gptw/gptw.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gptw.signIn",
        "title": "GPTW: Sign in"
      },
      {
        "command": "gptw.signOut",
        "title": "GPTW: Sign out"
      },
      {
        "command": "gptw.restore",
        "title": "GPTW: Restore Claude Code"
      },
      {
        "command": "gptw.status",
        "title": "GPTW: Show status"
      },
      {
        "command": "gptw.debugMenu",
        "title": "GPTW: Menu"
      },
      {
        "command": "gptw.editConfig",
        "title": "GPTW: Edit Config"
      },
      {
        "command": "gptw.diagnose",
        "title": "GPTW: Diagnose"
      },
      {
        "command": "gptw.test.fireImpressionRendered",
        "title": "GPTW (Test): Fire impression_rendered"
      },
      {
        "command": "gptw.test.fireImpressionViewable",
        "title": "GPTW (Test): Fire impression_viewable"
      },
      {
        "command": "gptw.test.fireViewTick",
        "title": "GPTW (Test): Fire view_tick"
      },
      {
        "command": "gptw.test.fireViewThresholdMet",
        "title": "GPTW (Test): Fire view_threshold_met (credits)"
      },
      {
        "command": "gptw.test.fireErrorImpression",
        "title": "GPTW (Test): Fire error_impression (5s stuck-session safety net)"
      },
      {
        "command": "gptw.test.fireClick",
        "title": "GPTW (Test): Fire click"
      },
      {
        "command": "gptw.test.refreshPortfolio",
        "title": "GPTW (Test): Refresh portfolio"
      },
      {
        "command": "gptw.test.refreshEarnings",
        "title": "GPTW (Test): Refresh earnings"
      },
      {
        "command": "gptw.test.getState",
        "title": "GPTW (Test): Get state snapshot"
      },
      {
        "command": "gptw.test.clearEventLog",
        "title": "GPTW (Test): Clear event log"
      },
      {
        "command": "gptw.test.disableInjection",
        "title": "GPTW (Test): Disable injection"
      },
      {
        "command": "gptw.test.enableInjection",
        "title": "GPTW (Test): Enable injection"
      },
      {
        "command": "gptw.test.refreshStatusBar",
        "title": "GPTW (Test): Refresh status bar"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gptw.test.fireImpressionRendered",
          "when": "gptw.test.enabled"
        },
        {
          "command": "gptw.test.fireImpressionViewable",
          "when": "gptw.test.enabled"
        },
        {
          "command": "gptw.test.fireViewTick",
          "when": "gptw.test.enabled"
        },
        {
          "command": "gptw.test.fireViewThresholdMet",
          "when": "gptw.test.enabled"
        },
        {
          "command": "gptw.test.fireErrorImpression",
          "when": "gptw.test.enabled"
        },
        {
          "command": "gptw.test.fireClick",
          "when": "gptw.test.enabled"
        },
        {
          "command": "gptw.test.refreshPortfolio",
          "when": "gptw.test.enabled"
        },
        {
          "command": "gptw.test.refreshEarnings",
          "when": "gptw.test.enabled"
        },
        {
          "command": "gptw.test.getState",
          "when": "gptw.test.enabled"
        },
        {
          "command": "gptw.test.clearEventLog",
          "when": "gptw.test.enabled"
        },
        {
          "command": "gptw.test.disableInjection",
          "when": "gptw.test.enabled"
        },
        {
          "command": "gptw.test.enableInjection",
          "when": "gptw.test.enabled"
        },
        {
          "command": "gptw.test.refreshStatusBar",
          "when": "gptw.test.enabled"
        }
      ]
    },
    "configuration": {
      "title": "GPTW",
      "properties": {
        "gptw.viewThresholdSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 600,
          "description": "Seconds of cumulative visible time an ad must accumulate before it counts as 'shown' and is credited."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "node scripts/gen-icon.mjs",
    "package": "node scripts/package.mjs",
    "marketplace:publish": "vsce publish --no-dependencies --packagePath gptw.vsix"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "20.14.0",
    "@types/vscode": "1.80.0",
    "@vscode/vsce": "2.31.0",
    "esbuild": "^0.23.0",
    "jsdom": "24.1.0",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  },
  "author": {
    "name": "GPTW",
    "url": "https://get-paid-to-wait-m44znelko-mayurs-projects-4c08c14e.vercel.app/"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://get-paid-to-wait-m44znelko-mayurs-projects-4c08c14e.vercel.app/",
  "bugs": {
    "url": "https://get-paid-to-wait-m44znelko-mayurs-projects-4c08c14e.vercel.app/"
  },
  "keywords": [
    "claude-code",
    "ads",
    "spinner",
    "earnings",
    "gptw"
  ]
}
